{
  "manifest_version": 3,
  "name": "Exam Questions to PDF",
  "version": "1.4.0",
  "description": "Download the pdf version of questions from public sites.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.localhost/*",
    "*://*.examprepper.co/*",
    "*://*.examtopics.com/*",
    "*://*.quizlet.com/*",
    "https://server.passorrefund.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.localhost/*",
        "*://*.examgrill.com/*",
        "*://*.examprepper.co/*",
        "*://*.examtopics.com/*",
        "*://*.quizlet.com/*"
      ],
      "js": [
        "sites.generated.js",
        "scraper.js",
        "autoscrape.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Exam Questions to PDF",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  }
}
