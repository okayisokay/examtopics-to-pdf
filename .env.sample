# Sites the extension scrapes. Comma separated, hostnames only — a port may be
# included for convenience but is dropped, since Chrome match patterns cover every
# port on a host. "*.host" also matches the bare host.
SCRAPE_HOSTS=localhost:3000,examtopics.com
SCRAPE_SCHEMES=*

VIEW_PATH_PATTERN=\/view\/?$|\/view\/\d+\/?$
